{
  "expo": {
    "name": "AdabiyotX",
    "slug": "adabiyotx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adabiyotx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.adabiyotx.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:adabiyotx.uz",
        "applinks:www.adabiyotx.uz"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "AdabiyotX accesses your photo library so you can select and upload a profile picture. The app only accesses the photo you choose.",
        "NSCameraUsageDescription": "AdabiyotX uses your camera so you can take and upload a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F4ED"
      },
      "package": "uz.adabiyotx.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "adabiyotx.uz"
            },
            {
              "scheme": "https",
              "host": "www.adabiyotx.uz"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://adabiyotx.uz"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "AdabiyotX accesses your photo library so you can select and upload a profile picture. The app only accesses the photo you choose.",
          "cameraPermission": "AdabiyotX uses your camera so you can take and upload a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020806",
          "dark": {
            "backgroundColor": "#020806"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://adabiyotx.uz"
      },
      "eas": {
        "projectId": "51bfbdc4-a4b5-4241-a058-78773ef722ab"
      }
    },
    "owner": "jaxongirman"
  }
}
